<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!--
    VCR design tokens. Every control in this library reads these keys; consumers override a key to
    retheme without touching control templates. Colors are sampled from ui-reference/ (Sony/Pioneer
    black chassis, silkscreen legends, REC red, power green, Smart Search yellow, amber VFD).
  -->

  <!-- Chassis: the molded body the controls sit in, darkest to lightest. -->
  <Color x:Key="Vcr.Color.Chassis.Deep">#101213</Color>
  <Color x:Key="Vcr.Color.Chassis">#17191B</Color>
  <Color x:Key="Vcr.Color.Chassis.Raised">#1F2225</Color>
  <Color x:Key="Vcr.Color.Chassis.Face">#25282B</Color>
  <Color x:Key="Vcr.Color.Chassis.Edge">#34383C</Color>
  <Color x:Key="Vcr.Color.Chassis.Highlight">#474C51</Color>

  <!-- Hard plastic key caps (transport, toolbar). -->
  <Color x:Key="Vcr.Color.Plastic.Top">#3A3E43</Color>
  <Color x:Key="Vcr.Color.Plastic.Bottom">#25282C</Color>
  <Color x:Key="Vcr.Color.Plastic.TopHover">#43484E</Color>
  <Color x:Key="Vcr.Color.Plastic.BottomHover">#2B2F33</Color>
  <Color x:Key="Vcr.Color.Plastic.TopPressed">#2B2E32</Color>
  <Color x:Key="Vcr.Color.Plastic.BottomPressed">#222528</Color>
  <Color x:Key="Vcr.Color.Plastic.Rim">#0B0C0D</Color>

  <!-- Matte rubber remote keys. -->
  <Color x:Key="Vcr.Color.Rubber">#2C2E31</Color>
  <Color x:Key="Vcr.Color.Rubber.Top">#36393C</Color>
  <Color x:Key="Vcr.Color.Rubber.Hover">#3A3D41</Color>
  <Color x:Key="Vcr.Color.Rubber.Pressed">#26282A</Color>

  <!-- Printed and embossed legends. -->
  <Color x:Key="Vcr.Color.Legend">#DCDFDB</Color>
  <Color x:Key="Vcr.Color.Legend.Dim">#8F969B</Color>
  <Color x:Key="Vcr.Color.Legend.Disabled">#5A6065</Color>
  <Color x:Key="Vcr.Color.Legend.OnCap">#CDD1CD</Color>

  <!-- Accents from the references. -->
  <Color x:Key="Vcr.Color.Red">#D2382E</Color>
  <Color x:Key="Vcr.Color.Red.Led">#FF5040</Color>
  <Color x:Key="Vcr.Color.Red.Deep">#7E1D18</Color>
  <Color x:Key="Vcr.Color.Green">#21A35D</Color>
  <Color x:Key="Vcr.Color.Green.Led">#4BE38A</Color>
  <Color x:Key="Vcr.Color.Green.Deep">#0F5A31</Color>
  <Color x:Key="Vcr.Color.Yellow">#F2C521</Color>
  <Color x:Key="Vcr.Color.Yellow.Soft">#3A3218</Color>
  <Color x:Key="Vcr.Color.Yellow.Ink">#2A2208</Color>
  <Color x:Key="Vcr.Color.Amber">#FF8F2E</Color>
  <Color x:Key="Vcr.Color.Amber.Ghost">#2A1A0E</Color>
  <Color x:Key="Vcr.Color.Focus">#8FC6DA</Color>
  <Color x:Key="Vcr.Color.Primary">#B7D4DD</Color>
  <Color x:Key="Vcr.Color.Primary.Ink">#182A31</Color>

  <!-- Display glass (LCD/VFD windows, text wells). -->
  <Color x:Key="Vcr.Color.Glass">#0B0D0E</Color>
  <Color x:Key="Vcr.Color.Glass.Edge">#050606</Color>
  <Color x:Key="Vcr.Color.Field">#121416</Color>
  <Color x:Key="Vcr.Color.Field.Focused">#15181A</Color>
  <Color x:Key="Vcr.Color.Field.Text">#E7EBEC</Color>
  <Color x:Key="Vcr.Color.Field.Placeholder">#6B7378</Color>
  <Color x:Key="Vcr.Color.Selection">#3C6878</Color>

  <!-- Tape material. -->
  <Color x:Key="Vcr.Color.Paper">#EAE5D5</Color>
  <Color x:Key="Vcr.Color.Paper.Rule">#CFC8B3</Color>
  <Color x:Key="Vcr.Color.Ink">#252D30</Color>
  <Color x:Key="Vcr.Color.Tape.Shell">#232526</Color>
  <Color x:Key="Vcr.Color.Tape.Rail">#2F3233</Color>
  <Color x:Key="Vcr.Color.Tape.Rim">#4A4E4F</Color>

  <!-- Brushes. -->
  <SolidColorBrush x:Key="Vcr.Brush.Chassis.Deep" Color="{StaticResource Vcr.Color.Chassis.Deep}"/>
  <SolidColorBrush x:Key="Vcr.Brush.Chassis" Color="{StaticResource Vcr.Color.Chassis}"/>
  <SolidColorBrush x:Key="Vcr.Brush.Chassis.Raised" Color="{StaticResource Vcr.Color.Chassis.Raised}"/>
  <SolidColorBrush x:Key="Vcr.Brush.Chassis.Face" Color="{StaticResource Vcr.Color.Chassis.Face}"/>
  <SolidColorBrush x:Key="Vcr.Brush.Chassis.Edge" Color="{StaticResource Vcr.Color.Chassis.Edge}"/>
  <SolidColorBrush x:Key="Vcr.Brush.Chassis.Highlight" Color="{StaticResource Vcr.Color.Chassis.Highlight}"/>
  <SolidColorBrush x:Key="Vcr.Brush.Plastic.Rim" Color="{StaticResource Vcr.Color.Plastic.Rim}"/>
  <SolidColorBrush x:Key="Vcr.Brush.Legend" Color="{StaticResource Vcr.Color.Legend}"/>
  <SolidColorBrush x:Key="Vcr.Brush.Legend.Dim" Color="{StaticResource Vcr.Color.Legend.Dim}"/>
  <SolidColorBrush x:Key="Vcr.Brush.Legend.Disabled" Color="{StaticResource Vcr.Color.Legend.Disabled}"/>
  <SolidColorBrush x:Key="Vcr.Brush.Legend.OnCap" Color="{StaticResource Vcr.Color.Legend.OnCap}"/>
  <SolidColorBrush x:Key="Vcr.Brush.Red" Color="{StaticResource Vcr.Color.Red}"/>
  <SolidColorBrush x:Key="Vcr.Brush.Red.Led" Color="{StaticResource Vcr.Color.Red.Led}"/>
  <SolidColorBrush x:Key="Vcr.Brush.Green" Color="{StaticResource Vcr.Color.Green}"/>
  <SolidColorBrush x:Key="Vcr.Brush.Green.Led" Color="{StaticResource Vcr.Color.Green.Led}"/>
  <SolidColorBrush x:Key="Vcr.Brush.Yellow" Color="{StaticResource Vcr.Color.Yellow}"/>
  <SolidColorBrush x:Key="Vcr.Brush.Yellow.Soft" Color="{StaticResource Vcr.Color.Yellow.Soft}"/>
  <SolidColorBrush x:Key="Vcr.Brush.Yellow.Ink" Color="{StaticResource Vcr.Color.Yellow.Ink}"/>
  <SolidColorBrush x:Key="Vcr.Brush.Amber" Color="{StaticResource Vcr.Color.Amber}"/>
  <SolidColorBrush x:Key="Vcr.Brush.Amber.Ghost" Color="{StaticResource Vcr.Color.Amber.Ghost}"/>
  <SolidColorBrush x:Key="Vcr.Brush.Focus" Color="{StaticResource Vcr.Color.Focus}"/>
  <SolidColorBrush x:Key="Vcr.Brush.Primary" Color="{StaticResource Vcr.Color.Primary}"/>
  <SolidColorBrush x:Key="Vcr.Brush.Primary.Ink" Color="{StaticResource Vcr.Color.Primary.Ink}"/>
  <SolidColorBrush x:Key="Vcr.Brush.Glass" Color="{StaticResource Vcr.Color.Glass}"/>
  <SolidColorBrush x:Key="Vcr.Brush.Glass.Edge" Color="{StaticResource Vcr.Color.Glass.Edge}"/>
  <SolidColorBrush x:Key="Vcr.Brush.Field" Color="{StaticResource Vcr.Color.Field}"/>
  <SolidColorBrush x:Key="Vcr.Brush.Field.Focused" Color="{StaticResource Vcr.Color.Field.Focused}"/>
  <SolidColorBrush x:Key="Vcr.Brush.Field.Text" Color="{StaticResource Vcr.Color.Field.Text}"/>
  <SolidColorBrush x:Key="Vcr.Brush.Field.Placeholder" Color="{StaticResource Vcr.Color.Field.Placeholder}"/>
  <SolidColorBrush x:Key="Vcr.Brush.Selection" Color="{StaticResource Vcr.Color.Selection}"/>
  <SolidColorBrush x:Key="Vcr.Brush.Paper" Color="{StaticResource Vcr.Color.Paper}"/>
  <SolidColorBrush x:Key="Vcr.Brush.Paper.Rule" Color="{StaticResource Vcr.Color.Paper.Rule}"/>
  <SolidColorBrush x:Key="Vcr.Brush.Ink" Color="{StaticResource Vcr.Color.Ink}"/>
  <SolidColorBrush x:Key="Vcr.Brush.Tape.Shell" Color="{StaticResource Vcr.Color.Tape.Shell}"/>
  <SolidColorBrush x:Key="Vcr.Brush.Tape.Rail" Color="{StaticResource Vcr.Color.Tape.Rail}"/>
  <SolidColorBrush x:Key="Vcr.Brush.Tape.Rim" Color="{StaticResource Vcr.Color.Tape.Rim}"/>
  <SolidColorBrush x:Key="Vcr.Brush.Rubber" Color="{StaticResource Vcr.Color.Rubber}"/>

  <LinearGradientBrush x:Key="Vcr.Brush.Plastic" StartPoint="0%,0%" EndPoint="0%,100%">
    <GradientStop Offset="0" Color="{StaticResource Vcr.Color.Plastic.Top}"/>
    <GradientStop Offset="1" Color="{StaticResource Vcr.Color.Plastic.Bottom}"/>
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="Vcr.Brush.Plastic.Hover" StartPoint="0%,0%" EndPoint="0%,100%">
    <GradientStop Offset="0" Color="{StaticResource Vcr.Color.Plastic.TopHover}"/>
    <GradientStop Offset="1" Color="{StaticResource Vcr.Color.Plastic.BottomHover}"/>
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="Vcr.Brush.Plastic.Pressed" StartPoint="0%,0%" EndPoint="0%,100%">
    <GradientStop Offset="0" Color="{StaticResource Vcr.Color.Plastic.TopPressed}"/>
    <GradientStop Offset="1" Color="{StaticResource Vcr.Color.Plastic.BottomPressed}"/>
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="Vcr.Brush.Plastic.Primary" StartPoint="0%,0%" EndPoint="0%,100%">
    <GradientStop Offset="0" Color="#C9E0E7"/>
    <GradientStop Offset="1" Color="#9FC0CB"/>
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="Vcr.Brush.Plastic.Primary.Pressed" StartPoint="0%,0%" EndPoint="0%,100%">
    <GradientStop Offset="0" Color="#A3C2CC"/>
    <GradientStop Offset="1" Color="#93B5C0"/>
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="Vcr.Brush.Plastic.Destructive" StartPoint="0%,0%" EndPoint="0%,100%">
    <GradientStop Offset="0" Color="#C8392F"/>
    <GradientStop Offset="1" Color="#93241D"/>
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="Vcr.Brush.Plastic.Destructive.Pressed" StartPoint="0%,0%" EndPoint="0%,100%">
    <GradientStop Offset="0" Color="#9C2A22"/>
    <GradientStop Offset="1" Color="#86211B"/>
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="Vcr.Brush.Plastic.Go" StartPoint="0%,0%" EndPoint="0%,100%">
    <GradientStop Offset="0" Color="#2BB868"/>
    <GradientStop Offset="1" Color="#178A4A"/>
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="Vcr.Brush.Plastic.Go.Pressed" StartPoint="0%,0%" EndPoint="0%,100%">
    <GradientStop Offset="0" Color="#1D9152"/>
    <GradientStop Offset="1" Color="#167B42"/>
  </LinearGradientBrush>
  <RadialGradientBrush x:Key="Vcr.Brush.Rubber.Dome" Center="50%,35%" GradientOrigin="50%,30%" RadiusX="70%" RadiusY="70%">
    <GradientStop Offset="0" Color="{StaticResource Vcr.Color.Rubber.Top}"/>
    <GradientStop Offset="1" Color="{StaticResource Vcr.Color.Rubber}"/>
  </RadialGradientBrush>
  <RadialGradientBrush x:Key="Vcr.Brush.Rubber.Dome.Hover" Center="50%,35%" GradientOrigin="50%,30%" RadiusX="70%" RadiusY="70%">
    <GradientStop Offset="0" Color="#404448"/>
    <GradientStop Offset="1" Color="{StaticResource Vcr.Color.Rubber.Hover}"/>
  </RadialGradientBrush>
  <RadialGradientBrush x:Key="Vcr.Brush.Rubber.Dome.Pressed" Center="50%,45%" GradientOrigin="50%,45%" RadiusX="70%" RadiusY="70%">
    <GradientStop Offset="0" Color="#2C2F32"/>
    <GradientStop Offset="1" Color="{StaticResource Vcr.Color.Rubber.Pressed}"/>
  </RadialGradientBrush>
  <LinearGradientBrush x:Key="Vcr.Brush.Faceplate" StartPoint="0%,0%" EndPoint="0%,100%">
    <GradientStop Offset="0" Color="#22252A"/>
    <GradientStop Offset="1" Color="#1A1C1F"/>
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="Vcr.Brush.Glass.Sheen" StartPoint="0%,0%" EndPoint="0%,100%">
    <GradientStop Offset="0" Color="#14FFFFFF"/>
    <GradientStop Offset="0.45" Color="#05FFFFFF"/>
    <GradientStop Offset="0.46" Color="#00FFFFFF"/>
    <GradientStop Offset="1" Color="#00FFFFFF"/>
  </LinearGradientBrush>

  <!-- Shadows. "Raised" is the cap's molded side wall plus its cast shadow; "Pressed" collapses both. -->
  <BoxShadows x:Key="Vcr.Shadow.Cap.Raised">0 1 0 0 #2EFFFFFF inset, 0 -1 0 0 #66000000 inset, 0 2 0 0 #0A0B0C, 0 3 5 0 #99000000</BoxShadows>
  <BoxShadows x:Key="Vcr.Shadow.Cap.Hover">0 1 0 0 #3DFFFFFF inset, 0 -1 0 0 #66000000 inset, 0 2 0 0 #0A0B0C, 0 4 7 0 #A6000000</BoxShadows>
  <BoxShadows x:Key="Vcr.Shadow.Cap.Pressed">0 1 2 0 #59000000 inset, 0 -1 0 0 #14FFFFFF inset, 0 0 0 0 #0A0B0C, 0 1 1 0 #80000000</BoxShadows>
  <BoxShadows x:Key="Vcr.Shadow.Rubber.Raised">0 1 1 0 #1FFFFFFF inset, 0 -2 3 0 #4D000000 inset, 0 2 0 0 #0E0F10, 0 3 6 0 #8C000000</BoxShadows>
  <BoxShadows x:Key="Vcr.Shadow.Rubber.Pressed">0 2 4 0 #66000000 inset, 0 0 0 0 #00FFFFFF inset, 0 0 0 0 #0E0F10, 0 1 2 0 #66000000</BoxShadows>
  <BoxShadows x:Key="Vcr.Shadow.Well">0 1 3 0 #CC000000 inset, 0 1 0 0 #1AFFFFFF</BoxShadows>
  <BoxShadows x:Key="Vcr.Shadow.Field">0 2 4 0 #B3000000 inset, 0 1 0 0 #14FFFFFF</BoxShadows>
  <BoxShadows x:Key="Vcr.Shadow.Field.Focused">0 2 4 0 #B3000000 inset, 0 0 0 2 #8FC6DA</BoxShadows>
  <BoxShadows x:Key="Vcr.Shadow.Bezel">0 1 0 0 #14FFFFFF inset, 0 -1 0 0 #59000000 inset, 0 6 16 0 #73000000</BoxShadows>
  <BoxShadows x:Key="Vcr.Shadow.Popup">0 1 0 0 #1AFFFFFF inset, 0 10 28 0 #B3000000</BoxShadows>
  <BoxShadows x:Key="Vcr.Shadow.Tape">0 3 5 0 #70000000</BoxShadows>
  <BoxShadows x:Key="Vcr.Shadow.Tape.Hover">0 6 10 0 #8C000000</BoxShadows>
  <BoxShadows x:Key="Vcr.Shadow.None">0 0 0 0 #00000000</BoxShadows>

  <!-- Z travel of a pressed key, and the lift of a hovered tape. -->
  <TransformOperations x:Key="Vcr.Travel.Rest">translate(0px, 0px)</TransformOperations>
  <TransformOperations x:Key="Vcr.Travel.Pressed">translate(0px, 2px)</TransformOperations>
  <TransformOperations x:Key="Vcr.Travel.RubberPressed">translate(0px, 1.5px) scale(0.985)</TransformOperations>
  <TransformOperations x:Key="Vcr.Travel.Lift">translate(0px, -2px)</TransformOperations>
  <x:TimeSpan x:Key="Vcr.Motion.Press">0:0:0.06</x:TimeSpan>
  <x:TimeSpan x:Key="Vcr.Motion.Hover">0:0:0.14</x:TimeSpan>

  <!-- Radii. -->
  <CornerRadius x:Key="Vcr.Radius.Cap">3</CornerRadius>
  <CornerRadius x:Key="Vcr.Radius.Well">5</CornerRadius>
  <CornerRadius x:Key="Vcr.Radius.Panel">6</CornerRadius>
  <CornerRadius x:Key="Vcr.Radius.Field">3</CornerRadius>
  <CornerRadius x:Key="Vcr.Radius.Chip">11</CornerRadius>
  <CornerRadius x:Key="Vcr.Radius.Pill">999</CornerRadius>
  <CornerRadius x:Key="Vcr.Radius.Tape">5</CornerRadius>

  <!-- Spacing (DESIGN.md: tight 8, group 16, section 24). -->
  <x:Double x:Key="Vcr.Space.Hair">2</x:Double>
  <x:Double x:Key="Vcr.Space.Tight">8</x:Double>
  <x:Double x:Key="Vcr.Space.Group">16</x:Double>
  <x:Double x:Key="Vcr.Space.Section">24</x:Double>
  <Thickness x:Key="Vcr.Padding.Cap">14,0</Thickness>
  <Thickness x:Key="Vcr.Padding.Field">10,7</Thickness>
  <Thickness x:Key="Vcr.Padding.Panel">12</Thickness>
  <Thickness x:Key="Vcr.Padding.Well">3</Thickness>

  <!-- Sizes. -->
  <x:Double x:Key="Vcr.Size.Control">34</x:Double>
  <x:Double x:Key="Vcr.Size.Toolbar">26</x:Double>
  <x:Double x:Key="Vcr.Size.Transport">40</x:Double>
  <x:Double x:Key="Vcr.Size.Rubber">34</x:Double>
  <x:Double x:Key="Vcr.Size.Icon">14</x:Double>
  <x:Double x:Key="Vcr.Size.Tape">60</x:Double>

  <!-- Typography. Barlow Semi Condensed approximates the condensed grotesque silkscreened on
       Sony remotes; DSEG7 is a seven-segment display face; Caveat is the handwritten tape label. -->
  <FontFamily x:Key="Vcr.Font.Legend">avares://HomeVideoLibrary.UI/Assets/Fonts#Barlow Semi Condensed</FontFamily>
  <FontFamily x:Key="Vcr.Font.Segment">avares://HomeVideoLibrary.UI/Assets/Fonts#DSEG7 Classic</FontFamily>
  <FontFamily x:Key="Vcr.Font.Hand">avares://HomeVideoLibrary.UI/Assets/Fonts#Caveat</FontFamily>
  <x:Double x:Key="Vcr.FontSize.Legend">11</x:Double>
  <x:Double x:Key="Vcr.FontSize.CapLegend">12</x:Double>
  <x:Double x:Key="Vcr.FontSize.Body">13</x:Double>
  <x:Double x:Key="Vcr.FontSize.Section">11</x:Double>
  <x:Double x:Key="Vcr.FontSize.Hand">27</x:Double>
  <x:Double x:Key="Vcr.LetterSpacing.Legend">0.6</x:Double>
</ResourceDictionary>
