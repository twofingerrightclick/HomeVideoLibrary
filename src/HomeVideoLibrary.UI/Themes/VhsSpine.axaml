<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:c="using:HomeVideoLibrary.UI.Controls">

  <LinearGradientBrush x:Key="Vcr.Brush.Tape.ShellFace" StartPoint="0%,0%" EndPoint="0%,100%">
    <GradientStop Offset="0" Color="#26292A"/>
    <GradientStop Offset="0.5" Color="#1D1F20"/>
    <GradientStop Offset="1" Color="#161718"/>
  </LinearGradientBrush>
  <SolidColorBrush x:Key="Vcr.Brush.Tape.Molding" Color="#6C7173"/>
  <SolidColorBrush x:Key="Vcr.Brush.Sticker.White" Color="#F6F4EE"/>
  <SolidColorBrush x:Key="Vcr.Brush.Sticker.Graph" Color="#F3F5F7"/>
  <SolidColorBrush x:Key="Vcr.Brush.Sticker.Cream" Color="#F1E8D2"/>
  <SolidColorBrush x:Key="Vcr.Brush.Sticker.Rule" Color="#DAD5C6"/>
  <SolidColorBrush x:Key="Vcr.Brush.Sticker.GraphRule" Color="#B9C9E2"/>
  <SolidColorBrush x:Key="Vcr.Brush.Tape.DefaultAccent" Color="#7D2A35"/>
  <!-- Printed sticker accents for hosts that vary spines (red, green, yellow, blue, purple, brown stock). -->
  <SolidColorBrush x:Key="Vcr.Brush.Spine.Red" Color="#7D2A35"/>
  <SolidColorBrush x:Key="Vcr.Brush.Spine.Green" Color="#2F5D4A"/>
  <SolidColorBrush x:Key="Vcr.Brush.Spine.Yellow" Color="#B08A1E"/>
  <SolidColorBrush x:Key="Vcr.Brush.Spine.Blue" Color="#3F5F95"/>
  <SolidColorBrush x:Key="Vcr.Brush.Spine.Purple" Color="#52407A"/>
  <SolidColorBrush x:Key="Vcr.Brush.Spine.Brown" Color="#7A5A2A"/>

  <!-- Hovered tape: pulled ~2.5% toward the viewer with a longer, softer shadow. -->
  <TransformOperations x:Key="Vcr.Travel.Forward">scale(1.025)</TransformOperations>
  <BoxShadows x:Key="Vcr.Shadow.Spine.Forward">0 10 22 0 #B3000000, 0 2 4 0 #66000000</BoxShadows>

  <!-- Printed sideways text on sticker bands; rotated -90deg so it reads bottom-to-top like a real spine. -->
  <ControlTheme x:Key="Vcr.Theme.SpinePrint" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{DynamicResource Vcr.Font.Legend}"/>
    <Setter Property="FontWeight" Value="Bold"/>
    <Setter Property="FontSize" Value="7.5"/>
    <Setter Property="LetterSpacing" Value="0.6"/>
    <Setter Property="HorizontalAlignment" Value="Center"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
  </ControlTheme>

  <ControlTheme x:Key="{x:Type c:VhsSpine}" TargetType="c:VhsSpine">
    <Setter Property="ClipToBounds" Value="False"/>
    <Setter Property="Accent" Value="{DynamicResource Vcr.Brush.Tape.DefaultAccent}"/>
    <Setter Property="Foreground" Value="{DynamicResource Vcr.Brush.Ink}"/>
    <Setter Property="Template">
      <ControlTemplate>
        <Panel>
          <!-- The spine is drawn on a fixed design face with a real VHS spine's 187:25 proportions and scaled
               uniformly, so label, sticker art and molding stay in proportion at any size. -->
          <!-- Viewbox clips by default, which would cut the forward-scaled shell and its shadow. -->
          <Viewbox Stretch="Uniform" ClipToBounds="False">
          <Border Name="PART_Shell"
                  Width="{x:Static c:VhsSpine.DesignWidth}"
                  Height="{x:Static c:VhsSpine.DesignHeight}"
                  Background="{DynamicResource Vcr.Brush.Tape.ShellFace}"
                  BorderBrush="#050505"
                  BorderThickness="1"
                  CornerRadius="6"
                  BoxShadow="{DynamicResource Vcr.Shadow.Tape}"
                  RenderTransformOrigin="50%,50%"
                  RenderTransform="scale(1)">
            <Border.Transitions>
              <Transitions>
                <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.12" Easing="CubicEaseOut"/>
                <BoxShadowsTransition Property="BoxShadow" Duration="0:0:0.12" Easing="CubicEaseOut"/>
              </Transitions>
            </Border.Transitions>
            <Panel>
              <!-- Molding seam and the door hinge marks at top and bottom center. -->
              <Border Margin="2" CornerRadius="5" BorderThickness="1" BorderBrush="#2E3233"
                      BoxShadow="0 1 0 0 #1FFFFFFF inset, 0 -1 0 0 #80000000 inset"/>
              <Border Width="54" Height="2" CornerRadius="1" Margin="0,2,0,0"
                      HorizontalAlignment="Center" VerticalAlignment="Top" Background="#3B3F41"/>
              <Border Width="54" Height="2" CornerRadius="1" Margin="0,0,0,2"
                      HorizontalAlignment="Center" VerticalAlignment="Bottom" Background="#0C0D0D"/>

              <Grid ColumnDefinitions="70,*,14">
                <!-- Shell end: molded text and the record-protect tab (or host content). -->
                <Panel>
                  <TextBlock Text="{TemplateBinding ShellText}"
                             Margin="11,9,0,0"
                             FontFamily="{DynamicResource Vcr.Font.Legend}"
                             FontSize="10"
                             FontWeight="SemiBold"
                             LetterSpacing="0.4"
                             Foreground="{DynamicResource Vcr.Brush.Tape.Molding}"
                             TextTrimming="CharacterEllipsis"
                             MaxWidth="54"
                             HorizontalAlignment="Left"
                             VerticalAlignment="Top"/>
                  <Border Name="PART_RecordTab"
                          Width="15" Height="17"
                          Margin="14,0,0,8"
                          HorizontalAlignment="Left"
                          VerticalAlignment="Bottom"
                          Background="#070808"
                          CornerRadius="1.5"
                          BoxShadow="0 1 0 0 #1AFFFFFF">
                    <Border Height="6" Margin="2,0,2,2" VerticalAlignment="Bottom" Background="#232627" CornerRadius="1"/>
                  </Border>
                  <ContentPresenter Name="PART_Leading"
                                    Content="{TemplateBinding LeadingContent}"
                                    IsVisible="{TemplateBinding LeadingContent, Converter={x:Static ObjectConverters.IsNotNull}}"
                                    Margin="6,0,6,4"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Bottom"/>
                </Panel>

                <!-- Sticker. -->
                <Border Name="PART_Sticker"
                        Grid.Column="1"
                        Margin="0,8"
                        CornerRadius="2"
                        Background="{DynamicResource Vcr.Brush.Sticker.White}"
                        BoxShadow="0 1 1 0 #66000000"
                        ClipToBounds="True">
                  <Grid ColumnDefinitions="Auto,*,Auto">
                    <!-- Branded: thin VIDEO / CASSETTE stripes at the left edge. -->
                    <StackPanel Name="PART_BrandStripes" Orientation="Horizontal" Margin="0,0,0,0" IsVisible="False">
                      <Border Width="11" Background="{TemplateBinding Accent}">
                        <LayoutTransformControl HorizontalAlignment="Center" VerticalAlignment="Center">
                          <LayoutTransformControl.LayoutTransform><RotateTransform Angle="-90"/></LayoutTransformControl.LayoutTransform>
                          <TextBlock Theme="{StaticResource Vcr.Theme.SpinePrint}" Text="VIDEO" Foreground="#F6F4EE"/>
                        </LayoutTransformControl>
                      </Border>
                      <Panel Width="12">
                        <Border Background="{TemplateBinding Accent}" Opacity="0.22"/>
                        <LayoutTransformControl HorizontalAlignment="Center" VerticalAlignment="Center">
                          <LayoutTransformControl.LayoutTransform><RotateTransform Angle="-90"/></LayoutTransformControl.LayoutTransform>
                          <TextBlock Theme="{StaticResource Vcr.Theme.SpinePrint}" Text="CASSETTE" Foreground="{TemplateBinding Accent}"/>
                        </LayoutTransformControl>
                      </Panel>
                    </StackPanel>

                    <!-- Graph: brand block at the left edge. -->
                    <Border Name="PART_GraphBlock" Width="26" Background="{TemplateBinding Accent}" IsVisible="False">
                      <LayoutTransformControl HorizontalAlignment="Center" VerticalAlignment="Center">
                        <LayoutTransformControl.LayoutTransform><RotateTransform Angle="-90"/></LayoutTransformControl.LayoutTransform>
                        <TextBlock Theme="{StaticResource Vcr.Theme.SpinePrint}" Text="{TemplateBinding BrandText}"
                                   FontSize="11" FontStyle="Italic" LetterSpacing="0.8" Foreground="#F6F4EE"/>
                      </LayoutTransformControl>
                    </Border>

                    <Panel Grid.Column="1">
                      <c:PaperRuling Name="PART_Ruling" Kind="Lined" Pitch="14" Margin="0,1"
                                     RuleBrush="{DynamicResource Vcr.Brush.Sticker.Rule}"/>
                      <TextBlock Name="PART_Label"
                                 Text="{TemplateBinding Label}"
                                 Margin="12,0,12,0"
                                 FontFamily="{DynamicResource Vcr.Font.Hand}"
                                 FontSize="{DynamicResource Vcr.FontSize.Hand}"
                                 FontWeight="Medium"
                                 Foreground="{TemplateBinding Foreground}"
                                 TextTrimming="CharacterEllipsis"
                                 TextWrapping="NoWrap"
                                 MaxLines="1"
                                 VerticalAlignment="Center"
                                 RenderTransform="translate(0px, -2px)"/>
                    </Panel>

                    <!-- Branded: brand block at the right edge. -->
                    <Border Name="PART_BrandBlock" Grid.Column="2" Width="30" Margin="0,3,3,3" CornerRadius="1.5"
                            Background="{TemplateBinding Accent}" IsVisible="False">
                      <LayoutTransformControl HorizontalAlignment="Center" VerticalAlignment="Center">
                        <LayoutTransformControl.LayoutTransform><RotateTransform Angle="-90"/></LayoutTransformControl.LayoutTransform>
                        <TextBlock Theme="{StaticResource Vcr.Theme.SpinePrint}" Text="{TemplateBinding BrandText}"
                                   FontSize="15" LetterSpacing="1" Foreground="#F6F4EE"/>
                      </LayoutTransformControl>
                    </Border>

                    <!-- Graph: narrow end strip at the right. -->
                    <Border Name="PART_GraphEnd" Grid.Column="2" Width="7" Background="{TemplateBinding Accent}" IsVisible="False"/>

                    <!-- Cream: rounded VIDEO / CASSETTE band at the right edge. -->
                    <Border Name="PART_CreamBand" Grid.Column="2" CornerRadius="0,6,6,0" ClipToBounds="True" IsVisible="False">
                      <StackPanel Orientation="Horizontal">
                        <Panel Width="13">
                          <Border Background="{TemplateBinding Accent}" Opacity="0.3"/>
                          <LayoutTransformControl HorizontalAlignment="Center" VerticalAlignment="Center">
                            <LayoutTransformControl.LayoutTransform><RotateTransform Angle="-90"/></LayoutTransformControl.LayoutTransform>
                            <TextBlock Theme="{StaticResource Vcr.Theme.SpinePrint}" Text="VIDEO" Foreground="{TemplateBinding Accent}"/>
                          </LayoutTransformControl>
                        </Panel>
                        <Border Width="14" Background="{TemplateBinding Accent}">
                          <LayoutTransformControl HorizontalAlignment="Center" VerticalAlignment="Center">
                            <LayoutTransformControl.LayoutTransform><RotateTransform Angle="-90"/></LayoutTransformControl.LayoutTransform>
                            <TextBlock Theme="{StaticResource Vcr.Theme.SpinePrint}" Text="CASSETTE" Foreground="#F6F4EE"/>
                          </LayoutTransformControl>
                        </Border>
                      </StackPanel>
                    </Border>
                  </Grid>
                </Border>

              </Grid>
            </Panel>
          </Border>
          </Viewbox>
          <Border Name="PART_FocusRing"
                  Margin="-3"
                  CornerRadius="8"
                  BorderThickness="2"
                  BorderBrush="{DynamicResource Vcr.Brush.Focus}"
                  IsVisible="False"/>
        </Panel>
      </ControlTemplate>
    </Setter>

    <Style Selector="^:branded">
      <Style Selector="^ /template/ StackPanel#PART_BrandStripes"><Setter Property="IsVisible" Value="True"/></Style>
      <Style Selector="^ /template/ Border#PART_BrandBlock"><Setter Property="IsVisible" Value="True"/></Style>
    </Style>
    <Style Selector="^:graph">
      <Style Selector="^ /template/ Border#PART_GraphBlock"><Setter Property="IsVisible" Value="True"/></Style>
      <Style Selector="^ /template/ Border#PART_GraphEnd"><Setter Property="IsVisible" Value="True"/></Style>
      <Style Selector="^ /template/ Border#PART_Sticker"><Setter Property="Background" Value="{DynamicResource Vcr.Brush.Sticker.Graph}"/></Style>
      <Style Selector="^ /template/ c|PaperRuling#PART_Ruling">
        <Setter Property="Kind" Value="Grid"/>
        <Setter Property="Pitch" Value="11"/>
        <Setter Property="RuleBrush" Value="{DynamicResource Vcr.Brush.Sticker.GraphRule}"/>
      </Style>
    </Style>
    <Style Selector="^:cream">
      <Style Selector="^ /template/ Border#PART_CreamBand"><Setter Property="IsVisible" Value="True"/></Style>
      <Style Selector="^ /template/ Border#PART_Sticker">
        <Setter Property="Background" Value="{DynamicResource Vcr.Brush.Sticker.Cream}"/>
        <Setter Property="CornerRadius" Value="6"/>
      </Style>
    </Style>
    <Style Selector="^:has-leading /template/ Border#PART_RecordTab">
      <Setter Property="IsVisible" Value="False"/>
    </Style>

    <!-- Hover brings the tape slightly forward, toward the viewer (scale and a deeper shadow, never a shift). A host that
         wants reduced motion adds the reduced-motion class to the window. -->
    <Style Selector="^:pointerover /template/ Border#PART_Shell">
      <Setter Property="RenderTransform" Value="{DynamicResource Vcr.Travel.Forward}"/>
      <Setter Property="BoxShadow" Value="{DynamicResource Vcr.Shadow.Spine.Forward}"/>
    </Style>
    <Style Selector="^:focus-visible /template/ Border#PART_FocusRing">
      <Setter Property="IsVisible" Value="True"/>
    </Style>
  </ControlTheme>
</ResourceDictionary>
