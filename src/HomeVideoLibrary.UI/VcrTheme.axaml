<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="using:HomeVideoLibrary.UI">
  <!--
    Entry point. Include after FluentTheme:
      <FluentTheme/>
      <StyleInclude Source="avares://HomeVideoLibrary.UI/VcrTheme.axaml"/>
    Resources here are searched before Fluent's, so the Fluent keys overridden in FluentResources.axaml
    restyle stock controls, and the type-keyed ControlThemes supply this library's controls.
  -->
  <Styles.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://HomeVideoLibrary.UI/Themes/Tokens.axaml"/>
        <ResourceInclude Source="avares://HomeVideoLibrary.UI/Themes/Icons.axaml"/>
        <ResourceInclude Source="avares://HomeVideoLibrary.UI/Themes/FluentResources.axaml"/>
        <ResourceInclude Source="avares://HomeVideoLibrary.UI/Themes/Buttons.axaml"/>
        <ResourceInclude Source="avares://HomeVideoLibrary.UI/Themes/Panels.axaml"/>
        <ResourceInclude Source="avares://HomeVideoLibrary.UI/Themes/Tabs.axaml"/>
        <ResourceInclude Source="avares://HomeVideoLibrary.UI/Themes/ScrubBar.axaml"/>
        <ResourceInclude Source="avares://HomeVideoLibrary.UI/Themes/TagChipInput.axaml"/>
        <ResourceInclude Source="avares://HomeVideoLibrary.UI/Themes/VhsSpine.axaml"/>
        <ResourceInclude Source="avares://HomeVideoLibrary.UI/Themes/Chapters.axaml"/>
        <ResourceInclude Source="avares://HomeVideoLibrary.UI/Themes/Slider.axaml"/>
        <ResourceInclude Source="avares://HomeVideoLibrary.UI/Themes/Lcd.axaml"/>
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Styles.Resources>

  <Style Selector="Window">
    <Setter Property="ui:ButtonPressFeedback.ReducedMotion" Value="{DynamicResource Vcr.ReducedMotion}"/>
  </Style>
  <Style Selector="Window.reduced-motion">
    <Setter Property="ui:ButtonPressFeedback.ReducedMotion" Value="True"/>
  </Style>

  <Style Selector="Button">
    <Setter Property="Theme" Value="{StaticResource Vcr.Theme.PlasticButton}"/>
  </Style>
  <Style Selector="ToggleButton">
    <Setter Property="Theme" Value="{StaticResource Vcr.Theme.LatchButton}"/>
  </Style>
  <Style Selector="TabControl.inspector">
    <Setter Property="Theme" Value="{StaticResource Vcr.Theme.InspectorTabControl}"/>
  </Style>

  <Style Selector="Slider.volume">
    <Setter Property="Theme" Value="{StaticResource Vcr.Theme.VolumeSlider}"/>
  </Style>

  <StyleInclude Source="avares://HomeVideoLibrary.UI/Themes/StockControls.axaml"/>
  <StyleInclude Source="avares://HomeVideoLibrary.UI/Themes/Surfaces.axaml"/>
</Styles>
