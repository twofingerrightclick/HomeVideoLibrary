<Styles xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:c="using:HomeVideoLibrary.UI.Controls">
 <!-- App-level surfaces built from the VCR library. Colors come only from Vcr.* tokens. -->
 <Style Selector="Window">
  <Setter Property="Background" Value="{DynamicResource Vcr.Brush.Chassis.Deep}"/>
  <Setter Property="Foreground" Value="{DynamicResource Vcr.Brush.Legend}"/>
  <Setter Property="FontSize" Value="{DynamicResource Vcr.FontSize.Body}"/>
 </Style>
 <Style Selector="ToolTip">
  <Setter Property="MaxWidth" Value="460"/>
 </Style>

 <!-- The drawer is the raised chassis edge of the shelf. -->
 <Style Selector="Border.drawer">
  <Setter Property="BorderBrush" Value="{DynamicResource Vcr.Brush.Chassis.Edge}"/>
  <Setter Property="BorderThickness" Value="0,0,1,0"/>
 </Style>

 <!-- A drawer navigation row that is not in the album list ("All videos"); lit like a selected list row when current. -->
 <Style Selector="Button.nav">
  <Setter Property="Theme" Value="{x:Null}"/>
  <Setter Property="Background" Value="Transparent"/>
  <Setter Property="Foreground" Value="{DynamicResource Vcr.Brush.Legend}"/>
  <Setter Property="Padding" Value="10,7"/>
  <Setter Property="CornerRadius" Value="{DynamicResource Vcr.Radius.Field}"/>
  <Setter Property="Template">
   <ControlTemplate>
    <Border Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}">
     <ContentPresenter Content="{TemplateBinding Content}" Padding="{TemplateBinding Padding}"
      HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"/>
    </Border>
   </ControlTemplate>
  </Setter>
 </Style>
 <Style Selector="Button.nav:pointerover">
  <Setter Property="Background" Value="{DynamicResource Vcr.Brush.Chassis.Face}"/>
 </Style>
 <Style Selector="Button.nav.current">
  <Setter Property="Background" Value="{DynamicResource Vcr.Brush.Selection}"/>
 </Style>
 <Style Selector="Button.nav:focus-visible">
  <Setter Property="Background" Value="{DynamicResource Vcr.Brush.Chassis.Face}"/>
 </Style>

 <!-- Text-only key for an inline action, such as opening a matched chapter. -->
 <Style Selector="Button.link">
  <Setter Property="Theme" Value="{x:Null}"/>
  <Setter Property="Foreground" Value="{DynamicResource Vcr.Brush.Focus}"/>
  <Setter Property="FontSize" Value="12"/>
  <Setter Property="Cursor" Value="Hand"/>
  <Setter Property="Template">
   <ControlTemplate>
    <ContentPresenter Content="{TemplateBinding Content}" Padding="4,2" Background="Transparent"/>
   </ControlTemplate>
  </Setter>
 </Style>
 <Style Selector="Button.link:pointerover">
  <Setter Property="Foreground" Value="{DynamicResource Vcr.Brush.Legend}"/>
 </Style>

 <!-- Amber-lit notice strip (missing tools, recovery snapshots). -->
 <Style Selector="Border.notice">
  <Setter Property="Background" Value="{DynamicResource Vcr.Brush.Amber.Ghost}"/>
  <Setter Property="BorderBrush" Value="{DynamicResource Vcr.Brush.Amber}"/>
  <Setter Property="BorderThickness" Value="1,0,0,0"/>
  <Setter Property="CornerRadius" Value="{DynamicResource Vcr.Radius.Field}"/>
  <Setter Property="Padding" Value="12,8"/>
 </Style>

 <!-- Hairline beside a month divider. -->
 <Style Selector="Border.rule">
  <Setter Property="Height" Value="1"/>
  <Setter Property="Background" Value="{DynamicResource Vcr.Brush.Chassis.Edge}"/>
 </Style>

 <!-- Sticky month label over the shelf: a paper sticker. -->
 <Style Selector="Border.pill">
  <Setter Property="Background" Value="{DynamicResource Vcr.Brush.Paper}"/>
  <Setter Property="CornerRadius" Value="{DynamicResource Vcr.Radius.Chip}"/>
  <Setter Property="Padding" Value="10,4"/>
  <Setter Property="BoxShadow" Value="{DynamicResource Vcr.Shadow.Popup}"/>
 </Style>
 <Style Selector="Border.pill > TextBlock">
  <Setter Property="Foreground" Value="{DynamicResource Vcr.Brush.Ink}"/>
  <Setter Property="FontFamily" Value="{DynamicResource Vcr.Font.Legend}"/>
  <Setter Property="FontWeight" Value="SemiBold"/>
  <Setter Property="LetterSpacing" Value="{DynamicResource Vcr.LetterSpacing.Legend}"/>
 </Style>

 <!-- Short confirmation label floating over the shelf. -->
 <Style Selector="Border.toast">
  <Setter Property="HorizontalAlignment" Value="Center"/>
  <Setter Property="Background" Value="{DynamicResource Vcr.Brush.Paper}"/>
  <Setter Property="CornerRadius" Value="{DynamicResource Vcr.Radius.Panel}"/>
  <Setter Property="BoxShadow" Value="{DynamicResource Vcr.Shadow.Popup}"/>
  <Setter Property="Padding" Value="16,10"/>
 </Style>
 <Style Selector="Border.toast > TextBlock">
  <Setter Property="Foreground" Value="{DynamicResource Vcr.Brush.Ink}"/>
 </Style>

 <!-- The shelf list: rows carry no fill of their own; the spine is the item. Keyboard focus rings the row. -->
 <Style Selector="ListBox.shelf">
  <Setter Property="Background" Value="Transparent"/>
  <Setter Property="Padding" Value="0,4,0,8"/>
 </Style>
 <Style Selector="ListBox.shelf ListBoxItem">
  <Setter Property="FocusAdorner" Value="{x:Null}"/>
  <!-- Selection and focus rings draw outside the spine. -->
  <Setter Property="ClipToBounds" Value="False"/>
  <Setter Property="Padding" Value="4,0"/>
  <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
 </Style>
 <!-- The hovered tape comes forward over its neighbours. -->
 <Style Selector="ListBox.shelf ListBoxItem:pointerover">
  <Setter Property="ZIndex" Value="1"/>
 </Style>
 <Style Selector="ListBox.shelf ListBoxItem /template/ ContentPresenter#PART_ContentPresenter, ListBox.shelf ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter, ListBox.shelf ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter, ListBox.shelf ListBoxItem:pressed /template/ ContentPresenter#PART_ContentPresenter">
  <Setter Property="Background" Value="Transparent"/>
 </Style>
 <Style Selector="ListBox.shelf ListBoxItem:focus-visible c|VhsSpine /template/ Border#PART_FocusRing">
  <Setter Property="IsVisible" Value="True"/>
 </Style>

 <!-- Activity LED: dark at rest, lit green while jobs run or wait. -->
 <Style Selector="Ellipse.led">
  <Setter Property="Fill" Value="{DynamicResource Vcr.Brush.Legend.Disabled}"/>
 </Style>
 <Style Selector="Ellipse.led.lit">
  <Setter Property="Fill" Value="{DynamicResource Vcr.Brush.Green.Led}"/>
 </Style>
 <Style Selector="TextBlock.meta.error">
  <Setter Property="Foreground" Value="{DynamicResource Vcr.Brush.Red.Led}"/>
 </Style>

 <!-- An album row a dragged tape would drop onto. -->
 <Style Selector="ListBox.vcr ListBoxItem.dropTarget /template/ ContentPresenter#PART_ContentPresenter">
  <Setter Property="Background" Value="{DynamicResource Vcr.Brush.Selection}"/>
  <Setter Property="BorderBrush" Value="{DynamicResource Vcr.Brush.Yellow}"/>
  <Setter Property="BorderThickness" Value="1"/>
 </Style>
</Styles>
