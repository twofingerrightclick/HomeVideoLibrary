<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:HomeVideoLibrary.Desktop.ViewModels" xmlns:core="using:HomeVideoLibrary.Core"
             x:Class="HomeVideoLibrary.Desktop.Views.ClipEditorView" x:DataType="vm:ClipEditorViewModel">
  <ScrollViewer>
    <StackPanel Spacing="16" MaxWidth="850" HorizontalAlignment="Stretch">
      <TextBlock Text="Create new clips" FontSize="26" FontWeight="SemiBold" />
      <TextBlock Text="Make a new video. Keep the original." TextWrapping="Wrap" Foreground="#B9C5CB" />
      <Expander Header="What your new clips include" HorizontalAlignment="Stretch">
        <TextBlock Text="New clips use the primary picture and audio. Descriptions, tags, chapters and up to 20 chosen thumbnails follow the new timeline. Extra tracks, subtitles and attachments remain in the originals. Trim and split preserve the original size and frame timing; merge uses the first clip’s format and pads other sizes. Silent clips receive silence." TextWrapping="Wrap" Foreground="#CBD0D8" MaxWidth="700" />
      </Expander>
      <TextBlock Text="{Binding OutputFormatSummary}" TextWrapping="Wrap" FontWeight="SemiBold" />
      <StackPanel Spacing="12" IsEnabled="{Binding !IsBusy}">
        <TextBlock Text="Output title" /><TextBox Text="{Binding OutputTitle, Mode=TwoWay}" AutomationProperties.Name="New video title" />
        <TextBlock Text="Clips in output order" FontSize="20" />
        <ListBox ItemsSource="{Binding Sources}" SelectedItem="{Binding SelectedSource, Mode=TwoWay}" MaxHeight="230" AutomationProperties.Name="Ordered clips to merge">
          <ListBox.ItemTemplate><DataTemplate x:DataType="core:LibraryVideo"><StackPanel Margin="8" Spacing="5"><TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" /><TextBlock Text="{Binding Duration}" Foreground="#CBD0D8" /></StackPanel></DataTemplate></ListBox.ItemTemplate>
        </ListBox>
        <StackPanel Orientation="Horizontal" Spacing="10" IsVisible="{Binding !IsSingle}">
          <Button Content="Move selected up" Click="MoveUpClicked" /><Button Content="Move selected down" Click="MoveDownClicked" />
          <Button Classes="primary" Content="Save merged MKV" Click="MergeClicked" IsEnabled="{Binding CanMerge}" />
        </StackPanel>
        <StackPanel IsVisible="{Binding IsSingle}" Spacing="12">
          <TextBlock Text="Trim to a range" FontSize="20" />
          <TextBlock Text="Choose a range at least 0.1 seconds long, within the original duration." TextWrapping="Wrap" Foreground="#CBD0D8" />
          <Grid ColumnDefinitions="*,*" ColumnSpacing="16">
            <StackPanel Spacing="6"><TextBlock Text="Start (seconds)" /><TextBox Text="{Binding StartSeconds, Mode=TwoWay}" AutomationProperties.Name="Trim start in seconds" /></StackPanel>
            <StackPanel Grid.Column="1" Spacing="6"><TextBlock Text="End (seconds)" /><TextBox Text="{Binding EndSeconds, Mode=TwoWay}" AutomationProperties.Name="Trim end in seconds" /></StackPanel>
          </Grid>
          <Button Classes="primary" Content="Save trimmed MKV" Click="TrimClicked" />
          <TextBlock Text="Split into two clips" FontSize="20" Margin="0,12,0,0" />
          <TextBlock Text="Split at (seconds)" /><TextBox Text="{Binding SplitSeconds, Mode=TwoWay}" AutomationProperties.Name="Split position in seconds" />
          <Button Classes="primary" Content="Save both MKVs" Click="SplitClicked" />
        </StackPanel>
      </StackPanel>
      <ProgressBar Value="{Binding Progress}" IsVisible="{Binding IsBusy}" />
      <Button Content="Cancel editing operation" Click="CancelClicked" IsVisible="{Binding IsBusy}" />
      <TextBlock Text="{Binding Status}" TextWrapping="Wrap" />
    </StackPanel>
  </ScrollViewer>
</UserControl>
