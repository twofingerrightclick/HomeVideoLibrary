<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:HomeVideoLibrary.Desktop.ViewModels" xmlns:core="using:HomeVideoLibrary.Core"
             x:Class="HomeVideoLibrary.Desktop.Views.ClipEditorView" x:DataType="vm:ClipEditorViewModel">
  <ScrollViewer>
    <StackPanel Spacing="16" MaxWidth="850" HorizontalAlignment="Stretch">
      <TextBlock Text="Create new clips" FontSize="26" FontWeight="SemiBold" />
      <TextBlock Text="Make a new video. Keep the original." TextWrapping="Wrap" Foreground="#B9C5CB" />
      <Expander Header="What your new clips include" HorizontalAlignment="Stretch">
        <TextBlock Text="New clips copy the original picture and sound without re-encoding, with every audio and subtitle track. Descriptions, tags, chapters and up to 20 chosen thumbnails follow the new timeline. Lossless cuts snap to keyframes, so a trim keeps a little more than you asked for; precise cuts re-encode only the fraction of a second next to each cut. Merging clips from different cameras re-encodes only the clips that do not match the rest." TextWrapping="Wrap" Foreground="#CBD0D8" MaxWidth="700" />
      </Expander>
      <StackPanel Spacing="12" IsEnabled="{Binding !IsBusy}">
        <TextBlock Text="Output title" /><TextBox Text="{Binding OutputTitle, Mode=TwoWay}" AutomationProperties.Name="New video title" />
        <TextBlock Text="Clips in output order" FontSize="20" />
        <ListBox ItemsSource="{Binding Sources}" SelectedItem="{Binding SelectedSource, Mode=TwoWay}" MaxHeight="230" AutomationProperties.Name="Ordered clips to merge">
          <ListBox.ItemTemplate><DataTemplate x:DataType="core:LibraryVideo"><StackPanel Margin="8" Spacing="5"><TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" /><TextBlock Text="{Binding Duration}" Foreground="#CBD0D8" /></StackPanel></DataTemplate></ListBox.ItemTemplate>
        </ListBox>
        <StackPanel Spacing="10" IsVisible="{Binding !IsSingle}">
          <TextBlock Text="{Binding MergePlanSummary}" TextWrapping="Wrap" FontWeight="SemiBold" />
          <StackPanel Orientation="Horizontal" Spacing="10">
            <Button Content="Move selected up" Click="MoveUpClicked" /><Button Content="Move selected down" Click="MoveDownClicked" />
            <Button Classes="primary" Content="Save merged MKV" Click="MergeClicked" IsEnabled="{Binding CanMerge}" />
          </StackPanel>
        </StackPanel>
        <StackPanel IsVisible="{Binding IsSingle}" Spacing="12">
          <TextBlock Text="Trim to a range" FontSize="20" />
          <TextBlock Text="Times are h:mm:ss.fff, m:ss or seconds." TextWrapping="Wrap" Foreground="#CBD0D8" />
          <Grid ColumnDefinitions="*,*" ColumnSpacing="16">
            <StackPanel Spacing="6"><TextBlock Text="Start" /><TextBox Text="{Binding StartTime, Mode=TwoWay}" AutomationProperties.Name="Trim start time" /></StackPanel>
            <StackPanel Grid.Column="1" Spacing="6"><TextBlock Text="End" /><TextBox Text="{Binding EndTime, Mode=TwoWay}" AutomationProperties.Name="Trim end time" /></StackPanel>
          </Grid>
          <CheckBox IsChecked="{Binding IsPrecise, Mode=TwoWay}" Content="Cut at the exact frames (re-encodes a fraction of a second at each cut)" />
          <TextBlock Text="{Binding TrimPlanSummary}" TextWrapping="Wrap" FontWeight="SemiBold" />
          <Button Classes="primary" Content="Save trimmed MKV" Click="TrimClicked" />
          <TextBlock Text="Split into two clips" FontSize="20" Margin="0,12,0,0" />
          <TextBlock Text="Split at" /><TextBox Text="{Binding SplitTime, Mode=TwoWay}" AutomationProperties.Name="Split time" />
          <TextBlock Text="{Binding SplitPlanSummary}" TextWrapping="Wrap" FontWeight="SemiBold" />
          <Button Classes="primary" Content="Save both MKVs" Click="SplitClicked" />
        </StackPanel>
      </StackPanel>
      <ProgressBar Value="{Binding Progress}" IsIndeterminate="{Binding IsProgressIndeterminate}" IsVisible="{Binding IsBusy}" />
      <Button Content="Cancel editing operation" Click="CancelClicked" IsVisible="{Binding IsBusy}" />
      <TextBlock Text="{Binding Status}" TextWrapping="Wrap" />
    </StackPanel>
  </ScrollViewer>
</UserControl>
