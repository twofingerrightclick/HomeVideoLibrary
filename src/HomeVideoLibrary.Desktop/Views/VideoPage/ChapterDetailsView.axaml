<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:HomeVideoLibrary.UI.Controls"
             xmlns:views="using:HomeVideoLibrary.Desktop.Views"
             xmlns:vp="using:HomeVideoLibrary.Desktop.ViewModels.VideoPage"
             x:Class="HomeVideoLibrary.Desktop.Views.VideoPage.ChapterDetailsView"
             x:DataType="vp:ChapterRowViewModel"
             IsEnabled="{Binding CanEdit}">
  <UserControl.Resources>
    <StreamGeometry x:Key="Page.Icon.BoundaryLeft">M7,2 L1,8 L7,14 L8.5,12.5 L5,9 H15 V7 H5 L8.5,3.5 Z</StreamGeometry>
    <StreamGeometry x:Key="Page.Icon.BoundaryRight">M9,2 L15,8 L9,14 L7.5,12.5 L11,9 H1 V7 H11 L7.5,3.5 Z</StreamGeometry>
  </UserControl.Resources>
  <!-- An expanded chapter row's editor. It is built when the row expands and dropped when it collapses. -->
  <StackPanel Spacing="6" Margin="12,2,10,10">
    <StackPanel Spacing="4">
        <TextBlock Classes="legend" Text="TITLE"/>
        <TextBox x:Name="TitleField" Text="{Binding TitleText, Mode=TwoWay}" Watermark="Untitled chapter or moment"
                 views:FieldBehaviors.FocusOnAttach="True" views:FieldBehaviors.LostFocusCommand="{Binding CommitDraftTitleCommand}"
                 AutomationProperties.Name="Chapter title" KeyDown="OnTitleKeyDown">
        </TextBox>
    </StackPanel>
    <TextBlock Classes="legend" Text="{Binding TypeLabel}"/>
    <Grid IsVisible="{Binding IsMoment}" ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto"
          ColumnSpacing="12" RowSpacing="6">
      <TextBlock Grid.ColumnSpan="2" Text="TIME" Classes="legend" FontWeight="SemiBold"
                 Foreground="{DynamicResource Vcr.Brush.Legend}"/>
      <TextBlock Grid.Row="1" Text="{Binding StartText}" VerticalAlignment="Center"
                 FontFamily="{DynamicResource Vcr.Font.Segment}" FontSize="12"
                 AutomationProperties.Name="Moment time"/>
      <c:PlasticButton Grid.Row="1" Grid.Column="1" Classes="toolbar" MinWidth="132"
                       HorizontalAlignment="Stretch" Content="SET TIME" Command="{Binding MoveToPlayheadCommand}"
                       ToolTip.Tip="Set this moment to the playhead"/>
    </Grid>
    <Grid IsVisible="{Binding !IsMoment}" ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto,8,Auto,Auto,Auto"
          ColumnSpacing="12" RowSpacing="6">
      <TextBlock Grid.ColumnSpan="2" Text="START" Classes="legend" FontWeight="SemiBold"
                 Foreground="{DynamicResource Vcr.Brush.Legend}"/>
      <TextBlock Grid.Row="1" Text="{Binding StartText}" VerticalAlignment="Center"
                 FontFamily="{DynamicResource Vcr.Font.Segment}" FontSize="12"
                 AutomationProperties.Name="Start time"/>
      <c:PlasticButton Grid.Row="1" Grid.Column="1" Classes="toolbar" MinWidth="132"
                       HorizontalAlignment="Stretch" Content="SET START TIME" Command="{Binding MoveToPlayheadCommand}"
                       ToolTip.Tip="Set this entry’s start to the playhead"/>
      <c:PlasticButton Grid.Row="2" Grid.ColumnSpan="2" Classes="toolbar" HorizontalAlignment="Stretch"
                       Content="SET START TIME TO PREVIOUS CHAPTER END"
                       Icon="{StaticResource Page.Icon.BoundaryLeft}" Command="{Binding SetStartToPreviousEndCommand}"
                       ToolTip.Tip="Use the previous range chapter’s end, or the clip start. Moments are ignored."/>
      <TextBlock Grid.Row="4" Grid.ColumnSpan="2" Text="END" Classes="legend" FontWeight="SemiBold"
                 Foreground="{DynamicResource Vcr.Brush.Legend}"/>
      <TextBlock Grid.Row="5" Text="{Binding EndText}" VerticalAlignment="Center"
                 FontFamily="{DynamicResource Vcr.Font.Segment}" FontSize="12"
                 AutomationProperties.Name="End time"/>
      <c:PlasticButton Grid.Row="5" Grid.Column="1" Classes="toolbar" MinWidth="132"
                       HorizontalAlignment="Stretch" Content="SET END TIME" Command="{Binding SetEndTimeCommand}"
                       ToolTip.Tip="Set this chapter’s end to the playhead."/>
      <c:PlasticButton Grid.Row="6" Grid.ColumnSpan="2" Classes="toolbar" HorizontalAlignment="Stretch"
                       Content="SET END TIME TO NEXT CHAPTER START"
                       Icon="{StaticResource Page.Icon.BoundaryRight}" Command="{Binding SetEndToNextStartCommand}"
                       ToolTip.Tip="Use the next range chapter’s start, or the clip end. Moments are ignored."/>
    </Grid>
    <TextBlock Classes="meta" TextWrapping="Wrap" Text="{Binding TimingError}"
               IsVisible="{Binding TimingError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
    <TextBlock Classes="legend" Text="DESCRIPTION" Margin="0,4,0,0"/>
    <TextBox Classes="area" Text="{Binding Description, Mode=TwoWay}" AcceptsReturn="True" TextWrapping="Wrap"
             MinHeight="56" MaxHeight="160" Watermark="What happens here?" AutomationProperties.Name="Chapter description"/>
    <TextBlock Classes="legend" Text="TAGS" Margin="0,4,0,0"/>
    <c:TagChipInput Watermark="Add tags…"
                    Tags="{Binding Tags.Items}"
                    Text="{Binding Tags.Draft, Mode=TwoWay}"
                    AddTagCommand="{Binding Tags.AddTagCommand}"
                    RemoveTagCommand="{Binding Tags.RemoveTagCommand}"
                    SuggestionProvider="{Binding Tags.Suggest}"/>
    <c:PlasticButton Classes="toolbar icon" HorizontalAlignment="Right" Margin="0,6,0,0"
                     Icon="{StaticResource Vcr.Icon.Trash}" Command="{Binding DeleteCommand}"
                     AutomationProperties.Name="Delete chapter or moment" ToolTip.Tip="Delete chapter or moment"/>
  </StackPanel>
</UserControl>
