<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:HomeVideoLibrary.UI.Controls"
             xmlns:vp="using:HomeVideoLibrary.Desktop.ViewModels.VideoPage"
             xmlns:local="using:HomeVideoLibrary.Desktop.Views.VideoPage"
             x:Class="HomeVideoLibrary.Desktop.Views.VideoPage.ChaptersTab"
             x:DataType="vp:VideoPageViewModel" DetachedFromVisualTree="OnDetached">
  <UserControl.Styles>
    <!-- Row keys show on hover, keyboard focus and expansion only, so titles keep the row's width. -->
    <Style Selector="c|ChapterListItem StackPanel.rowActions">
      <Setter Property="Opacity" Value="0"/>
    </Style>
    <Style Selector="c|ChapterListItem:pointerover StackPanel.rowActions, c|ChapterListItem:focus-within StackPanel.rowActions, c|ChapterListItem:expanded StackPanel.rowActions">
      <Setter Property="Opacity" Value="1"/>
    </Style>
  </UserControl.Styles>
  <StackPanel Spacing="10">
    <c:SectionHeader Title="CHAPTERS AND MOMENTS"/>
    <StackPanel Spacing="6">
      <c:PlasticButton Classes="toolbar" BorderBrush="{DynamicResource Vcr.Brush.Legend.Dim}"
                       Icon="{StaticResource Vcr.Icon.Moment}" Content="MOMENT (M)"
                       Command="{Binding AddMomentCommand}" ToolTip.Tip="Add a moment at the playhead (M)"/>
      <c:PlasticButton Classes="toolbar" Foreground="{DynamicResource Vcr.Brush.Yellow}"
                       BorderBrush="{DynamicResource Vcr.Brush.Yellow}"
                       Icon="{StaticResource Vcr.Icon.Chapter}" Content="CHAPTER (C)"
                       Command="{Binding AddChapterCommand}" ToolTip.Tip="Add a chapter at the playhead (C)"/>
    </StackPanel>

    <TextBlock Classes="meta" TextWrapping="Wrap" IsVisible="{Binding !Details.Chapters.HasChapters}"
               Text="Press C for a chapter or M for a moment at the playhead."/>
    <TextBlock Classes="meta" TextWrapping="Wrap" Text="{Binding Details.Chapters.TimingConflict}"
               IsVisible="{Binding Details.Chapters.TimingConflict, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
    <!-- The playhead moves only the placeholder, so a row being clicked or edited is never rebuilt. A row expands in
         place into its editor; the editor exists only while its row is expanded. -->
    <ItemsControl ItemsSource="{Binding Details.Chapters.Rows}">
      <ItemsControl.DataTemplates>
        <DataTemplate DataType="vp:ChapterRowViewModel">
          <c:ChapterListItem Margin="0,1" PointerEntered="OnChapterEntered" PointerExited="OnChapterExited"
                             Start="{Binding Start}" End="{Binding End}"
                             Title="{Binding Title}"
                             IsCurrent="{Binding IsCurrent}"
                             IsEditing="{Binding IsEditing, Mode=TwoWay}"
                             DraftTitle="{Binding DraftTitle, Mode=TwoWay}"
                             ActivateCommand="{Binding SeekCommand}"
                             EditCommand="{Binding EditCommand}"
                             SeekCommand="{Binding SeekCommand}"
                             CommitTitleCommand="{Binding CommitTitleCommand}"
                             IsExpanded="{Binding IsExpanded}"
                             ExpandedContent="{Binding Editor}"
                             ExpandedContentTemplate="{x:Static local:ChapterDetailsView.ViewTemplate}"
                             ToolTip.Tip="Click to jump here; use Edit to change the chapter or moment">
            <StackPanel Orientation="Horizontal" Spacing="12" Classes="rowActions">
              <c:PlasticButton Classes="toolbar icon" MinWidth="38" Icon="{StaticResource Vcr.Icon.Edit}" Command="{Binding EditCommand}"
                               ToolTip.Tip="Edit (F2)"/>
              <c:PlasticButton Classes="toolbar icon" Icon="{StaticResource Vcr.Icon.Close}" Command="{Binding DeleteCommand}"
                               ToolTip.Tip="Remove chapter or moment (Delete)"/>
            </StackPanel>
          </c:ChapterListItem>
        </DataTemplate>
        <DataTemplate DataType="vp:PlaceholderRowViewModel">
          <c:ChapterPlaceholderRow Margin="0,1" Start="{Binding Start}" IsVisible="{Binding IsShown}"/>
        </DataTemplate>
      </ItemsControl.DataTemplates>
    </ItemsControl>
  </StackPanel>
</UserControl>
