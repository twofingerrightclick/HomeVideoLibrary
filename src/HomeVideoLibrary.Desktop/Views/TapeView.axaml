<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:vm="using:HomeVideoLibrary.Desktop.ViewModels" xmlns:c="using:HomeVideoLibrary.UI.Controls" xmlns:views="using:HomeVideoLibrary.Desktop.Views"
 x:Class="HomeVideoLibrary.Desktop.Views.TapeView" x:DataType="vm:TapeViewModel" ClipToBounds="False">
 <!-- A spine on the shelf plus its hover preview. The list item, not the spine, takes keyboard focus. -->
 <Panel>
  <c:VhsSpine x:Name="Spine" Focusable="False" IsTabStop="False"
   Label="{Binding Label}" Sticker="{Binding Spine.Sticker}" BrandText="{Binding Spine.BrandText}"
   Accent="{Binding Spine.AccentKey, Converter={x:Static views:ResourceConverter.Instance}}"
   ShellText="{Binding ShellText}" IsSelected="{Binding IsSelected}" Command="{Binding OpenCommand}"
   Classes.problem="{Binding HasProblem}" ToolTip.Tip="{Binding ProblemDetail}"
   AutomationProperties.Name="{Binding Label}">
   <c:VhsSpine.LeadingContent>
    <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" Focusable="False" AutomationProperties.Name="Select video"
     ToolTip.Tip="Select for albums or clip editing"/>
   </c:VhsSpine.LeadingContent>
  </c:VhsSpine>
  <Popup x:Name="PreviewPopup" PlacementTarget="{Binding #Spine}" Placement="Bottom" IsLightDismissEnabled="False" IsHitTestVisible="False">
   <Border Classes="bezel" Padding="5" IsHitTestVisible="False">
    <Grid Width="208" Height="132" RowDefinitions="112,20">
     <Image x:Name="PreviousPreview" Stretch="UniformToFill"/>
     <Image x:Name="CurrentPreview" Stretch="UniformToFill"/>
     <TextBlock x:Name="PreviewTime" Grid.Row="1" Classes="meta" HorizontalAlignment="Center" VerticalAlignment="Center"/>
    </Grid>
   </Border>
  </Popup>
 </Panel>
</UserControl>
