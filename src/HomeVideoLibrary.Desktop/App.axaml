<Application xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="HomeVideoLibrary.Desktop.App" RequestedThemeVariant="Dark">
 <Application.Styles>
  <FluentTheme/>
  <Style Selector="Window"><Setter Property="FontSize" Value="13"/><Setter Property="Foreground" Value="#E7EBEC"/></Style>
  <Style Selector="Button"><Setter Property="MinHeight" Value="34"/><Setter Property="Padding" Value="13,7"/><Setter Property="CornerRadius" Value="4"/></Style>
  <Style Selector="Button.primary"><Setter Property="Background" Value="#B7D4DD"/><Setter Property="Foreground" Value="#182A31"/></Style>
  <Style Selector="TextBox"><Setter Property="CornerRadius" Value="4"/><Setter Property="MinHeight" Value="34"/></Style>
  <Style Selector="ComboBox"><Setter Property="MinHeight" Value="34"/></Style>
  <Style Selector="ToolTip"><Setter Property="MaxWidth" Value="460"/></Style>
 </Application.Styles>
</Application>
