<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:g="using:HomeVideoLibrary.Gallery"
             xmlns:c="using:HomeVideoLibrary.UI.Controls"
             x:Class="HomeVideoLibrary.Gallery.Sections.ScrubSection">
  <StackPanel Spacing="0">
    <TextBlock Classes="gallery-title" Text="SCRUB BAR" Margin="0,0,0,14"/>

    <Border Classes="gallery-plate">
      <StackPanel Spacing="10">
        <TextBlock Classes="gallery-note" Text="Playing at 35% with footage buffered ahead — 42-minute tape, 8 chapters (one only 5 s long, held at minimum width)"/>
        <c:ScrubBar x:Name="PlayingBar" Width="1000" HorizontalAlignment="Left"/>
      </StackPanel>
    </Border>

    <Border Classes="gallery-plate">
      <StackPanel Spacing="10">
        <TextBlock Classes="gallery-note" Text="PreviewMarkerPosition — where MARK would insert a chapter"/>
        <c:ScrubBar x:Name="MarkerBar" Width="1000" HorizontalAlignment="Left"/>
      </StackPanel>
    </Border>

    <Border Classes="gallery-plate">
      <StackPanel Spacing="10">
        <TextBlock Classes="gallery-note" Text="RangeStart / RangeEnd — trim in and out points"/>
        <c:ScrubBar x:Name="RangeBar" Width="1000" HorizontalAlignment="Left"/>
      </StackPanel>
    </Border>

    <Border Classes="gallery-plate">
      <StackPanel Spacing="10">
        <TextBlock Classes="gallery-note" Text="Hover — tooltip follows the pointer, hovered chapter rises, bar and thumb grow"/>
        <c:ScrubBar x:Name="HoverBar" Width="1000" HorizontalAlignment="Left" Margin="0,46,0,0"/>
      </StackPanel>
    </Border>

    <Border Classes="gallery-plate">
      <StackPanel Spacing="10">
        <TextBlock Classes="gallery-note" Text="No chapters — one continuous track (keyboard focus shown)"/>
        <c:ScrubBar x:Name="PlainBar" Width="1000" HorizontalAlignment="Left" g:ForcedState.States=":focus-visible"/>
      </StackPanel>
    </Border>

    <Border Classes="gallery-plate">
      <StackPanel Spacing="10">
        <TextBlock Classes="gallery-note" Text="Disabled"/>
        <c:ScrubBar x:Name="DisabledBar" Width="1000" HorizontalAlignment="Left" IsEnabled="False"/>
      </StackPanel>
    </Border>

    <Border Classes="gallery-plate">
      <StackPanel Spacing="12">
        <TextBlock Classes="gallery-note" Text="Live — drag, click, or focus and use Left/Right (Shift for 1 s), Home, End. Hover MARK to preview the insert point."/>
        <c:ScrubBar x:Name="LiveBar" Width="1000" HorizontalAlignment="Left" Margin="0,46,0,0"/>
        <StackPanel Orientation="Horizontal" Spacing="10">
          <c:LatchButton x:Name="PlayLatch" Content="PLAY" Icon="{StaticResource Vcr.Icon.Play}"/>
          <c:PlasticButton x:Name="MarkButton" Content="MARK" Icon="{StaticResource Vcr.Icon.Slice}"/>
          <TextBlock x:Name="LiveReadout" Classes="gallery-note" VerticalAlignment="Center"/>
        </StackPanel>
      </StackPanel>
    </Border>
  </StackPanel>
</UserControl>
