<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="HomeVideoLibrary.Gallery.App"
             RequestedThemeVariant="Dark">
  <Application.Styles>
    <FluentTheme/>
    <StyleInclude Source="avares://HomeVideoLibrary.UI/VcrTheme.axaml"/>
    <StyleInclude Source="avares://HomeVideoLibrary.Gallery/GalleryStyles.axaml"/>
  </Application.Styles>
</Application>
